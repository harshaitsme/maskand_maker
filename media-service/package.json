{
  "name": "media-service",
  "version": "1.0.0",
  "description": "Mask & Maker Media, MinIO/S3 Storage & 3D AR Assets Microservice (MVC + MongoDB + RabbitMQ)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "seed": "node ./node_modules/tsx/dist/cli.mjs src/scripts/seed.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [
    "mask-and-maker",
    "media-service",
    "minio",
    "s3",
    "glb",
    "3d-photogrammetry",
    "ar",
    "microservice",
    "mvc",
    "mongodb",
    "rabbitmq"
  ],
  "author": "Mask & Maker Engineering",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mime-types": "^2.1.35",
    "minio": "^8.0.4",
    "mongoose": "^8.12.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
