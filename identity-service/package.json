{
  "name": "identity-service",
  "version": "1.0.0",
  "description": "Mask & Maker Identity, User Accounts, JWT Authentication & RBAC Microservice (MVC + MongoDB)",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "seed": "node ./node_modules/tsx/dist/cli.mjs src/scripts/seed.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "keywords": [
    "mask-and-maker",
    "identity-service",
    "authentication",
    "jwt",
    "rbac",
    "microservice",
    "mvc",
    "mongodb"
  ],
  "author": "Mask & Maker Engineering",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.12.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
